# Konfigurasi Aplikasi
APP_NAME="Inainu MVC Studio"
APP_ENV=development
APP_URL="http://127.0.0.1:8000/"

# Konfigurasi Database (Pilihan Driver: sqlite atau mysql)
DB_DRIVER=sqlite
DB_FILE="../database.sqlite"

# Jika menggunakan MySQL (ubah DB_DRIVER=mysql)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=inainu_db
DB_USER=root
DB_PASS=
